# Load this file with `EnvLoader::substitution(true)`; dollar signs are literal by default.

VAR=one
VAR_2=two
EMPTY=

# Unset variables expand to an empty string.
RESULT=$NOPE # value: ''

# Unbraced names include ASCII letters, digits, and underscores.
RESULT=$VAR_2 # value: 'two'

# Braces delimit the name when text immediately follows it.
RESULT=${VAR}_suffix # value: 'one_suffix'

# Single-quoted values are literal. A backslash can also escape a dollar sign.
RESULT='$VAR' # value: '$VAR'
RESULT=\$VAR # value: '$VAR'

# Two dollar signs produce one literal dollar sign when substitution is enabled.
RESULT=$$VAR # value: '$VAR'

# Shell/Compose-style default and alternate values are supported.
RESULT=${NOPE:-fallback} # value: 'fallback' when unset or empty
RESULT=${EMPTY-fallback} # value: '' because EMPTY is set
RESULT=${VAR:+alternate} # value: 'alternate' when set and non-empty

# Required substitutions stop parsing with an error. The text after ? is the message.
# RESULT=${REQUIRED:?set REQUIRED before loading this file}

# Substitution lookup follows EnvSequence. Explicit values supplied with
# EnvLoader::substitutions are also available without changing the process environment.
